{
  "name": "simulador-deportivo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-data.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-data.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "datos:demo": "tsx scripts/generate-demo-data.ts",
    "datos:futbol": "tsx scripts/import-fc-csv.ts",
    "datos:nfl": "tsx scripts/import-madden-csv.ts",
    "calibrar:futbol": "tsx scripts/calibrate-football.ts",
    "calibrar:nfl": "tsx scripts/calibrate-nfl.ts",
    "calibrar:dc": "tsx scripts/calibrate-dc.ts",
    "calibrar": "npm run calibrar:futbol && npm run calibrar:nfl && npm run calibrar:dc",
    "test": "tsx scripts/test-season.ts && tsx scripts/test-nfl.ts && tsx scripts/test-dc.ts"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}